{
  "name": "cibo-drive",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w @cibo/web\" \"npm run dev -w @cibo/api\"",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w @cibo/api",
    "build": "npm run build --workspaces",
    "infra:check": "node --env-file=.env --import tsx apps/api/src/check-infra.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4",
    "typescript": "~5.9.3"
  }
}
